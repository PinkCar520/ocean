{
  "name": "@ocean/core",
  "version": "1.0.0",
  "description": "Core TypeScript library and shared types for Ocean Monorepo",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./permission-policy": {
      "types": "./dist/permission-policy.d.ts",
      "import": "./dist/permission-policy.js",
      "require": "./dist/permission-policy.js"
    },
    "./session-permission-grants": {
      "types": "./dist/session-permission-grants.d.ts",
      "import": "./dist/session-permission-grants.js",
      "require": "./dist/session-permission-grants.js"
    },
    "./checkpoints": {
      "types": "./dist/filesystem/checkpoints.d.ts",
      "import": "./dist/filesystem/checkpoints.js",
      "require": "./dist/filesystem/checkpoints.js"
    },
    "./file-system": {
      "types": "./dist/filesystem/file-system.d.ts",
      "import": "./dist/filesystem/file-system.js",
      "require": "./dist/filesystem/file-system.js"
    },
    "./security": {
      "types": "./dist/filesystem/security.d.ts",
      "import": "./dist/filesystem/security.js",
      "require": "./dist/filesystem/security.js"
    },
    "./notebook-snapshots": {
      "types": "./dist/filesystem/notebook-snapshots.d.ts",
      "import": "./dist/filesystem/notebook-snapshots.js",
      "require": "./dist/filesystem/notebook-snapshots.js"
    }
  },
  "dependencies": {
    "@ocean/contracts": "workspace:*",
    "bash-parser": "^0.5.0",
    "ignore": "7.0.5",
    "tiktoken": "^1.0.22"
  },
  "scripts": {
    "build": "pnpm --filter @ocean/contracts build && tsc",
    "test": "vitest run src/agent-execution-protocol.spec.ts src/context-engine.spec.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.6"
  },
  "typesVersions": {
    "*": {
      "permission-policy": [
        "dist/permission-policy.d.ts"
      ],
      "session-permission-grants": [
        "dist/session-permission-grants.d.ts"
      ],
      "checkpoints": [
        "dist/filesystem/checkpoints.d.ts"
      ],
      "file-system": [
        "dist/filesystem/file-system.d.ts"
      ],
      "security": [
        "dist/filesystem/security.d.ts"
      ],
      "notebook-snapshots": [
        "dist/filesystem/notebook-snapshots.d.ts"
      ]
    }
  }
}
