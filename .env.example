# ==========================================
# 默认模型提供商设置 (用来决定系统默认使用哪个)
# ==========================================
DEFAULT_AI_PROVIDER=deepseek    # 可选: deepseek, claude, gemini, dashscope, openai, local

# ==========================================
# 1. DeepSeek 配置
# ==========================================
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=

# ==========================================
# 2. Anthropic (Claude) 配置
# ==========================================
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY
ANTHROPIC_MODEL=

# ==========================================
# 3. Google Gemini 配置
# ==========================================
GEMINI_API_KEY=YOUR_GEMINI_KEY
GEMINI_MODEL=

# ==========================================
# 4. 阿里百炼 (DashScope) 配置
# ==========================================
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_KEY
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=

# ==========================================
# 5. OpenAI 官方配置
# ==========================================
OPENAI_API_KEY=YOUR_OPENAI_KEY
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# ==========================================
# 6. 本地私有化模型 (vLLM / Ollama)
# ==========================================
LOCAL_API_KEY=ollama
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=
# Gateway 服务启动端口
PORT=3000

# 生产数据库与身份验证（请替换为随机强密码，不要提交真实密钥）
POSTGRES_USER=ocean
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_RANDOM_PASSWORD
POSTGRES_DB=ocean
DATABASE_URL=postgresql://ocean:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/ocean?schema=public
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# 禅道集成配置 (ZenTao Integration)
# 例: http://zentao.your-bank.com；留空则自动进入 mock 模式
# 本地演示: gateway 在容器内用 http://zentao:80；在宿主机用 http://localhost:8080（需 --profile integrations）
ZENTAO_BASE_URL=
# 禅道 API Token 或 用户名:密码 的 Base64
ZENTAO_API_TOKEN=

# Jenkins CI/CD 集成配置（可选，指向已有 Jenkins 实例）
# 例: https://jenkins.example.com
# 留空则 Jenkins 能力保持禁用
# 本地演示: gateway 在容器内用 http://jenkins:8080；在宿主机用 http://localhost:8082（需 --profile integrations）
JENKINS_BASE_URL=
# Jenkins API Token (在用户设置中生成)
JENKINS_TOKEN=

# GitLab 代码托管集成配置（可选，指向已有 GitLab 实例）
# 例: https://gitlab.example.com
# 留空则 GitLab 能力保持禁用
# 本地演示: gateway 在容器内用 http://gitlab:80；在宿主机用 http://localhost:8083（需 --profile integrations）
GITLAB_BASE_URL=
# GitLab Personal Access Token (需 api, read_user 权限)
GITLAB_TOKEN=


# ==========================================
# 7. Embedding Config
# ==========================================
# FastAPI RAG 默认使用 openai sdk，如果在此定义，则专门用于向量模型名字
EMBEDDING_MODEL_NAME=text-embedding-3-small


# ==========================================
# Network Configs
# ==========================================
VITE_API_BASE_URL=
OCEAN_GATEWAY_URL=http://localhost:3000
# Optional Desktop development proxy override. Defaults to the Workspace Host Gateway.
OCEAN_DESKTOP_API_PROXY_URL=

# Optional HTTPS coarse IP geolocation for login devices. The public client IP is
# sent to this provider. Leave empty to keep locations unavailable.
# The endpoint receives /<ip> and returns JSON with city, region and country.
# For a reverse proxy, set TRUST_PROXY to the actual proxy addresses and ensure
# the ingress proxy sanitizes X-Forwarded-For.
LOGIN_GEOIP_URL=
