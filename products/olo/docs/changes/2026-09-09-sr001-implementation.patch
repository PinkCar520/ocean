+import XCTest
+@testable import OLO
+
+final class WakeSessionTests: XCTestCase {
+    func testBackwardPlanningAndQuietWindow() {
+        var s = WakeSession()
+        XCTAssertEqual(s.latest, 460)
+        XCTAssertEqual(s.departure, 507)
+        XCTAssertEqual(s.preferred, 450)
+        s.apply(.start)
+        XCTAssertEqual(s.phase, .quiet)
+        s.apply(.advance(12))
+        XCTAssertEqual(s.phase, .ambient)
+        s.apply(.advance(2))
+        XCTAssertEqual(s.phase, .prompt)
+        s.apply(.advance(8))
+        XCTAssertEqual(s.phase, .atRisk)
+        XCTAssertNil(s.awakeAt)
+    }
+    func testTrafficReplanDoesNotChangeMeeting() {
+        var s = WakeSession()
+        s.apply(.start)
+        s.apply(.traffic(61))
+        XCTAssertEqual(s.latest, 452)
+        XCTAssertEqual(s.preferred, 442)
+        XCTAssertEqual(s.meeting, 570)
+        s.apply(.advance(6))
+        XCTAssertEqual(s.phase, .prompt)
+    }
+    func testSnoozeRequiresConfirmationAndBoundsDelay() {
+        var s = WakeSession()
+        s.apply(.start)
+        s.apply(.advance(19)) // 07:37, three feasible minutes remain.
+        s.apply(.requestSnooze)
+        XCTAssertNil(s.snoozeUntil)
+        XCTAssertEqual(s.proposedSnooze, 460)
+        s.apply(.acceptSnooze)
+        XCTAssertEqual(s.phase, .snoozing)
+        s.apply(.advance(3))
+        XCTAssertEqual(s.phase, .atRisk)
+        s.apply(.requestSnooze)
+        XCTAssertNil(s.proposedSnooze)
+    }
+    func testTrafficInvalidatesAcceptedSnooze() {
+        var s = WakeSession()
+        s.apply(.start)
+        s.apply(.advance(14))
+        s.apply(.requestSnooze)
+        s.apply(.acceptSnooze)
+        XCTAssertEqual(s.phase, .snoozing)
+        s.apply(.traffic(61))
+        XCTAssertEqual(s.phase, .atRisk)
+        XCTAssertNil(s.snoozeUntil)
+    }
+    func testChangedEvidenceCannotAcceptOldProposal() {
+        var s = WakeSession()
+        s.apply(.start)
+        s.apply(.requestSnooze)
+        s.apply(.traffic(61))
+        s.apply(.acceptSnooze)
+        XCTAssertNil(s.snoozeUntil)
+        s.apply(.requestSnooze)
+        s.apply(.permission(false))
+        s.apply(.acceptSnooze)
+        XCTAssertEqual(s.phase, .permissionRequired)
+    }
+    func testMissingStaleAndRevokedContext() {
+        var s = WakeSession()
+        s.apply(.start)
+        s.apply(.advance(30)) // validity boundary is exclusive.
+        XCTAssertEqual(s.phase, .needsContext)
+        s.apply(.traffic(53))
+        XCTAssertEqual(s.phase, .atRisk)
+        s.apply(.calendarAvailable(false))
+        XCTAssertEqual(s.phase, .needsContext)
+        s.apply(.permission(false))
+        XCTAssertEqual(s.phase, .permissionRequired)
+        s.apply(.calendarAvailable(true))
+        XCTAssertEqual(s.phase, .permissionRequired)
+        s.apply(.permission(true))
+        XCTAssertEqual(s.phase, .atRisk)
+    }
+    func testExplicitAwakeStopsAllFurtherIntervention() {
+        var s = WakeSession()
+        s.apply(.start)
+        s.apply(.invalidateTraffic)
+        s.apply(.acknowledge) // Explicit human evidence does not require inferred context.
+        let complete = s
+        s.apply(.advance(30))
+        s.apply(.traffic(61))
+        s.apply(.requestSnooze)
+        s.apply(.acknowledge)
+        XCTAssertEqual(s, complete)
+        XCTAssertEqual(s.awakeAt, 438)
+    }
+    func testCancellationAndDuplicateStartAreIdempotent() {
+        var s = WakeSession()
+        s.apply(.start)
+        let count = s.entries.count
+        s.apply(.start)
+        XCTAssertEqual(s.entries.count, count)
+        s.apply(.cancel)
+        let cancelled = s
+        s.apply(.advance(5))
+        s.apply(.acknowledge)
+        XCTAssertEqual(s, cancelled)
+        XCTAssertNil(s.awakeAt)
+    }
+    func testInvalidDurationsDoNotCorruptPlan() {
+        var s = WakeSession()
+        s.apply(.start)
+        let original = s
+        s.apply(.traffic(-1))
+        s.apply(.traffic(241))
+        s.apply(.advance(-1))
+        XCTAssertEqual(s, original)
+    }
+    func testSnapshotRoundTripPreservesSnoozeAndEvidence() throws {
+        var s = WakeSession()
+        s.apply(.start)
+        s.apply(.requestSnooze)
+        s.apply(.acceptSnooze)
+        let restored = try JSONDecoder().decode(WakeSession.self, from: JSONEncoder().encode(s))
+        XCTAssertEqual(restored, s)
+    }
+}
+
+@MainActor
+final class WakeControllerTests: XCTestCase {
+    actor Store: WakeSessionStoring {
+        enum Failure: Error { case unavailable }
+        var snapshot: WakeSession?
+        var failing = false
+        func setFailing(_ value: Bool) { failing = value }
+        func load() throws -> WakeSession? {
+            if failing { throw Failure.unavailable }
+            return snapshot
+        }
+        func save(_ session: WakeSession) throws {
+            if failing { throw Failure.unavailable }
+            snapshot = session
+        }
+    }
+    func testFailedSaveIsVisibleAndBlocksFurtherInputUntilRetry() async {
+        let store = Store()
+        let controller = WakeDemoController(store: store)
+        await controller.load()
+        await store.setFailing(true)
+        await controller.send(.start)
+        XCTAssertNotNil(controller.storageError)
+        let now = controller.session.now
+        await controller.send(.advance(5))
+        XCTAssertEqual(controller.session.now, now)
+        await store.setFailing(false)
+        await controller.retry()
+        XCTAssertNil(controller.storageError)
+        let restored = WakeDemoController(store: store)
+        await restored.load()
+        XCTAssertEqual(restored.session, controller.session)
+    }
+    func testLoadFailureRequiresExplicitRetryOrReset() async {
+        let store = Store()
+        await store.setFailing(true)
+        let controller = WakeDemoController(store: store)
+        await controller.load()
+        XCTAssertFalse(controller.loaded)
+        await controller.send(.start)
+        XCTAssertFalse(controller.session.started)
+        await store.setFailing(false)
+        await controller.reset()
+        XCTAssertTrue(controller.loaded)
+        XCTAssertNil(controller.storageError)
+        XCTAssertFalse(controller.session.started)
+    }
+    func testFileStorePersistsAndReportsCorruption() async throws {
+        let url = FileManager.default.temporaryDirectory.appending(path: UUID().uuidString)
+        defer { try? FileManager.default.removeItem(at: url) }
+        let store = WakeSessionStore(url: url)
+        var session = WakeSession()
+        session.apply(.start)
+        session.apply(.acknowledge)
+        try await store.save(session)
+        let restored = try await store.load()
+        XCTAssertEqual(restored, session)
+        try Data("corrupt".utf8).write(to: url)
+        do {
+            _ = try await store.load()
+            XCTFail("Corrupt data must not be silently reset")
+        } catch { /* A visible recovery path is required. */ }
+    }
+}
