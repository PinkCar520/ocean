+import Foundation
+
+/// SR-001's deterministic foreground fixture. Times are minutes in one simulated day,
+/// never wall-clock alarms or claims about sensed sleep.
+struct WakeSession: Codable, Equatable, Sendable {
+    enum Phase: String, Codable, Sendable {
+        case idle, quiet, ambient, prompt, atRisk, needsContext, permissionRequired, snoozing, awake, cancelled
+    }
+    enum Input: Sendable {
+        case start, advance(Int), traffic(Int), invalidateTraffic, calendarAvailable(Bool)
+        case permission(Bool), acknowledge, requestSnooze, acceptSnooze, declineSnooze, cancel
+    }
+    struct Entry: Codable, Equatable, Identifiable, Sendable {
+        let id: UUID
+        let minute: Int
+        let text: String
+    }
+    private(set) var now = 438 // 07:18
+    var meeting: Int { 570 } // 09:30
+    var arrivalBuffer: Int { 10 }
+    var preparation: Int { 47 }
+    private(set) var commute = 53
+    private(set) var trafficValidUntil = 468
+    private(set) var hasCalendar = true
+    private(set) var authorized = false
+    private(set) var started = false
+    private(set) var phase: Phase = .idle
+    private(set) var snoozeUntil: Int?
+    private(set) var proposedSnooze: Int?
+    private(set) var awakeAt: Int?
+    private(set) var entries: [Entry] = []
+
+    var latest: Int { meeting - arrivalBuffer - commute - preparation }
+    var preferred: Int { latest - 10 }
+    var earliest: Int { preferred - 5 }
+    var departure: Int { meeting - arrivalBuffer - commute }
+    var isTerminal: Bool { phase == .awake || phase == .cancelled }
+    var contextValid: Bool { hasCalendar && now < trafficValidUntil }
+    var canRespond: Bool { started && !isTerminal }
+
+    static func time(_ minute: Int) -> String {
+        let value = max(0, minute)
+        return String(format: "%02d:%02d", value / 60, value % 60)
+    }
+
+    mutating func apply(_ input: Input) {
+        guard !isTerminal else { return }
+        let previous = phase
+        switch input {
+        case .start:
+            guard !started else { return }
+            started = true
+            authorized = true // Explicit start button grants only this demo's visual intervention.
+            record("开始本次模拟；允许页面内提示。")
+        case .advance(let minutes):
+            guard started, (1...60).contains(minutes) else { return }
+            now = min(1439, now + minutes)
+            proposedSnooze = nil
+        case .traffic(let minutes):
+            guard (1...240).contains(minutes) else { return }
+            commute = minutes
+            trafficValidUntil = now + 30
+            proposedSnooze = nil
+            record("模拟交通更新：\(minutes) 分钟；有效 30 分钟。")
+        case .invalidateTraffic:
+            trafficValidUntil = now
+            proposedSnooze = nil
+            record("模拟交通证据过期。")
+        case .calendarAvailable(let available):
+            hasCalendar = available
+            proposedSnooze = nil
+            record(available ? "恢复模拟日程。" : "模拟日程缺失。")
+        case .permission(let allowed):
+            authorized = allowed
+            if !allowed { snoozeUntil = nil; proposedSnooze = nil }
+            record(allowed ? "允许本次页面内提示。" : "撤销页面内提示授权。")
+        case .acknowledge:
+            guard canRespond else { return }
+            awakeAt = now
+            snoozeUntil = nil
+            proposedSnooze = nil
+            phase = .awake
+            record("用户明确回应「我醒了」；停止唤醒，等待 SR-002。")
+            return
+        case .requestSnooze:
+            guard canRespond, authorized, contextValid else { return }
+            let minutes = min(10, max(0, latest - now))
+            proposedSnooze = minutes > 0 ? now + minutes : nil
+            record(minutes > 0 ? "请求再睡 10 分钟；可选 \(minutes) 分钟，等待确认。" : "已无可用延后时间；不自动改变日程。")
+        case .acceptSnooze:
+            guard canRespond, authorized, contextValid,
+                  let proposedSnooze, proposedSnooze > now, proposedSnooze <= latest else {
+                self.proposedSnooze = nil
+                evaluate()
+                return
+            }
+            snoozeUntil = proposedSnooze
+            self.proposedSnooze = nil
+            record("用户确认延后至 \(Self.time(proposedSnooze))。")
+        case .declineSnooze:
+            proposedSnooze = nil
+            record("用户放弃延后。")
+        case .cancel:
+            guard started else { return }
+            phase = .cancelled
+            snoozeUntil = nil
+            proposedSnooze = nil
+            record("用户取消本次模拟；未改变日程或设置闹钟。")
+            return
+        }
+        evaluate()
+        if phase != previous { record(summary) }
+    }
+
+    private mutating func evaluate() {
+        guard started, !isTerminal else { return }
+        guard authorized else { phase = .permissionRequired; return }
+        guard contextValid else { phase = .needsContext; return }
+        if let until = snoozeUntil {
+            // Traffic changes can invalidate an accepted delay.
+            if until > latest {
+                snoozeUntil = nil
+                record("交通变化使延后方案失效，重新计算。")
+            } else if now < until {
+                phase = .snoozing
+                return
+            } else {
+                snoozeUntil = nil
+            }
+        }
+        if now >= latest { phase = .atRisk }
+        else if now < preferred { phase = .quiet }
+        else if now < preferred + 2 { phase = .ambient }
+        else { phase = .prompt }
+    }
+
+    var summary: String {
+        switch phase {
+        case .idle: "准备好后开始模拟"
+        case .quiet: "现在可以保持安静"
+        case .ambient: "进入起床窗口，轻量提示"
+        case .prompt: "差不多该起来了"
+        case .atRisk: "已到最晚起床时间，需要你决定"
+        case .needsContext: "缺少有效情境，暂停起床判断"
+        case .permissionRequired: "提示已暂停，等待授权"
+        case .snoozing: "延后期间保持安静"
+        case .awake: "你已确认醒来"
+        case .cancelled: "本次模拟已取消"
+        }
+    }
+
+    private mutating func record(_ text: String) {
+        entries.append(Entry(id: UUID(), minute: now, text: text))
+        if entries.count > 100 { entries.removeFirst(entries.count - 100) }
+    }
+}
