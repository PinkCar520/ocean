+import Foundation
+import Observation
+
+@MainActor
+@Observable
+final class WakeDemoController {
+    private(set) var session = WakeSession()
+    private(set) var isBusy = false
+    private(set) var loaded = false
+    private(set) var storageError: String?
+    private let store: any WakeSessionStoring
+
+    init(store: any WakeSessionStoring = WakeSessionStore()) { self.store = store }
+
+    func load() async {
+        guard !loaded, !isBusy else { return }
+        isBusy = true
+        defer { isBusy = false }
+        do {
+            session = try await store.load() ?? WakeSession()
+            loaded = true
+            storageError = nil
+        } catch {
+            storageError = "无法读取上次模拟。请重试，或明确开始新记录。"
+        }
+    }
+
+    func send(_ input: WakeSession.Input) async {
+        guard loaded, !isBusy, storageError == nil else { return }
+        session.apply(input)
+        await persist()
+    }
+
+    func reset() async {
+        guard !isBusy else { return }
+        session = WakeSession()
+        loaded = true
+        await persist()
+    }
+
+    func retry() async {
+        if loaded { await persist() } else { await load() }
+    }
+
+    private func persist() async {
+        guard !isBusy else { return }
+        isBusy = true
+        defer { isBusy = false }
+        do {
+            try await store.save(session)
+            storageError = nil
+        } catch {
+            storageError = "本次状态尚未保存。请重试保存后继续。"
+        }
+    }
+}
