+import Foundation
+
+protocol WakeSessionStoring: Sendable {
+    func load() async throws -> WakeSession?
+    func save(_ session: WakeSession) async throws
+}
+
+/// A single local simulation snapshot; no sensor history or long-term routine learning.
+actor WakeSessionStore: WakeSessionStoring {
+    private let url: URL
+    init(url: URL = URL.documentsDirectory.appending(path: "sr001-demo.json")) {
+        self.url = url
+    }
+    func load() throws -> WakeSession? {
+        guard FileManager.default.fileExists(atPath: url.path) else { return nil }
+        return try JSONDecoder().decode(WakeSession.self, from: Data(contentsOf: url))
+    }
+    func save(_ session: WakeSession) throws {
+        try JSONEncoder().encode(session).write(to: url, options: .atomic)
+    }
+}
