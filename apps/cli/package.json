{
  "name": "@ocean/cli",
  "version": "1.0.0",
  "description": "Ocean Terminal Deep Interaction Node",
  "main": "dist/index.js",
  "bin": {
    "ocean": "./dist/index.js"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "pnpm --filter @ocean/core build",
    "build": "tsc",
    "pretypecheck": "pnpm --filter @ocean/core build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "start:daemon": "node dist/index.js daemon",
    "pretest": "pnpm --filter @ocean/core build",
    "test": "vitest run",
    "test:faults": "vitest run src/llm/chat.security.spec.ts src/utils/permission-policy.spec.ts src/utils/tool-journal.spec.ts src/utils/session-store.spec.ts src/utils/checkpoints.spec.ts src/tools/local/git.workflow.spec.ts src/mcp/client.spec.ts src/subagents/delegate.spec.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.106",
    "@ai-sdk/google": "^4.0.122",
    "@ai-sdk/openai": "^4.0.121",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@ocean/contracts": "workspace:*",
    "@ocean/core": "workspace:*",
    "@ocean/tools-zentao": "workspace:*",
    "ai": "^7.0.176",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^17.3.1",
    "glob": "^10.3.10",
    "ink": "^6.0.0",
    "ink-text-input": "^6.0.0",
    "inquirer": "^9.2.0",
    "open": "^11.0.0",
    "ora": "^8.0.1",
    "react": "^19.0.0",
    "socket.io-client": "^4.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.6"
  }
}
