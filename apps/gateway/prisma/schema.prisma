// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// 影子用户信息表（SSO 自动同步）
model User {
  id         String  @id @default(uuid())
  workId     String  @unique // 工号，唯一标识
  name       String?
  email      String?
  avatar     String?
  department String?
  password   String? // Hashed password for local authentication

  // 关联信息
  preferences        UserPreference?
  credentials        UserCredential[]
  sessions           Session[]
  skillInstallations SkillInstallation[]
  apiKeys            ApiKey[]
  skills             Skill[]
  skillVersions      SkillVersion[]
  agentRuns          AgentRun[]
  memberships        Membership[]
  identities         Identity[]
  contextGrants      ContextGrant[] // 作为授权人发起的跨 Space 授权

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ─────────────────────────────────────────────
// Phase 5：Space 数据边界（ADR-001）
// Code / Work / Life 建模为一级 Space；会话、记忆、连接、
// Skill 安装、知识库与 Run 必须归属 Space；跨 Space 访问
// 默认拒绝，只能通过显式 ContextGrant 开放。
// ─────────────────────────────────────────────
model Space {
  id          String  @id // 人工可读 ID（'work' / 'code' / 'life'），避免 UUID 谜语
  slug        String  @unique // 唯一别名
  name        String
  type        String // 'code' | 'work' | 'life'
  icon        String?
  description String? @db.Text

  memberships        Membership[]
  policySets         PolicySet[]
  sessions           Session[]
  knowledgeProjects  KnowledgeProject[]
  skillInstallations SkillInstallation[]
  mcpServers         MCPServer[]
  documents          Document[]
  codeRepositories   CodeRepository[]
  terminalSessions   TerminalSession[]
  terminalCommands   TerminalCommand[]
  workProjects       WorkProject[]
  workTasks          WorkTask[]
  agentRuns          AgentRun[]
  grantsFrom         ContextGrant[]      @relation("GrantFrom")
  grantsTo           ContextGrant[]      @relation("GrantTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("spaces")
}

model Membership {
  id        String   @id @default(uuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member") // 'owner' | 'admin' | 'member'
  createdAt DateTime @default(now())

  @@unique([spaceId, userId])
  @@index([userId])
  @@map("memberships")
}

model Identity {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String   @default("personal") // 'personal' | 'organization' | 'device' | 'api'
  name       String?
  attributes Json? // 身份附加属性（组织域、设备指纹等）
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("identities")
}

model PolicySet {
  id        String   @id @default(uuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  key       String // 'tools' | 'memory' | 'connections' | 'model' | 'dataRetention'
  rules     Json? // 策略规则 JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([spaceId, key])
  @@map("policy_sets")
}

model ContextGrant {
  id              String    @id @default(uuid())
  fromSpaceId     String // 来源 Space（数据所在方）
  fromSpace       Space     @relation("GrantFrom", fields: [fromSpaceId], references: [id], onDelete: Cascade)
  toSpaceId       String // 目标 Space（使用方）
  toSpace         Space     @relation("GrantTo", fields: [toSpaceId], references: [id], onDelete: Cascade)
  scope           Json? // 授权范围，如 { sessions: [...], tools: [...], projects: [...] }
  purpose         String? // 授权用途（用户可见）
  grantedByUserId String?
  grantedBy       User?     @relation(fields: [grantedByUserId], references: [id], onDelete: SetNull)
  expiresAt       DateTime? // 限时授权
  revokedAt       DateTime? // 撤销时间（非空=已撤销）
  createdAt       DateTime  @default(now())

  @@index([fromSpaceId])
  @@index([toSpaceId])
  @@map("context_grants")
}

// Ocean v2 持久化执行实例。Space 外键将在 Phase 5 引入 Space 模型后补齐。
model AgentRun {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId        String
  space          Space         @relation(fields: [spaceId], references: [id])
  spaceType      String
  input          String        @db.Text
  status         String        @default("queued")
  priority       String        @default("interactive") // critical | interactive | background（Phase 4 第 6 项）
  idempotencyKey String?
  metadata       Json?
  events         RunEvent[]
  steps          RunStep[]
  approvals      RunApproval[]
  artifacts      RunArtifact[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, status])
  @@index([spaceId, createdAt])
  @@map("agent_runs")
}

// RunStep：Run 的步骤化执行记录（模型调用/工具调用/审批/产物），
// 状态推进以 RunStep 为粒度，RunEvent 是其可投递投影（对应 ADR-003）。
model RunStep {
  id          String    @id @default(uuid())
  runId       String
  run         AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq         Int
  kind        String    @default("model_call") // model_call | tool_call | approval | artifact
  status      String    @default("started") // started | succeeded | failed | interrupted
  input       Json?
  output      Json?
  error       String?   @db.Text
  checkpoint  Json?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([runId, seq])
  @@index([runId, status])
  @@map("run_steps")
}

model RunEvent {
  id         String   @id @default(uuid())
  runId      String
  run        AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sequence   Int
  type       String
  payload    Json
  occurredAt DateTime @default(now())

  @@unique([runId, sequence])
  @@index([runId, occurredAt])
  @@map("run_events")
}

// RunApproval：Run 维度的审批记录（对应 contracts approvalSchema，Phase 4 第 5 项）。
// 需要审批的工具（Tool.requiresApproval）执行前先创建 pending 审批，
// Run 进入 waiting_for_approval；决策后 approved → 重新投递续跑（从检查点继续），
// rejected/expired → Run 终态 cancelled。
model RunApproval {
  id         String    @id @default(uuid())
  runId      String
  run        AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  toolCallId String
  toolName   String
  args       Json
  status     String    @default("pending") // pending | approved | rejected | expired
  decidedBy  String?
  decidedAt  DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([runId, status])
  @@map("run_approvals")
}

// RunArtifact：Run 的产物引用（Phase 4 第 8 项，借鉴 K6：大产物不入 PG）。
// 内容落在 ArtifactStore（本地对象存储目录），DB 只存元数据 + storageKey 引用。
model RunArtifact {
  id         String   @id @default(uuid())
  runId      String
  run        AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  name       String
  sizeBytes  Int
  storageKey String   @unique // 形如 "<runId>/<artifactId>"
  createdAt  DateTime @default(now())

  @@index([runId])
  @@map("run_artifacts")
}

// Transactional Outbox：业务状态与待处理消息原子提交，Worker 通过租约竞争消费。
model OutboxEvent {
  id            String    @id @default(uuid())
  topic         String
  aggregateType String
  aggregateId   String
  payload       Json
  status        String    @default("pending")
  priorityRank  Int       @default(1) // 0=critical, 1=interactive, 2=background（Phase 4 第 6 项）
  availableAt   DateTime  @default(now())
  lockedAt      DateTime?
  lockedBy      String?
  attempts      Int       @default(0)
  lastError     String?   @db.Text
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([status, availableAt])
  @@index([status, priorityRank, availableAt])
  @@index([lockedAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

// 用户 AI 个性化配置
model UserPreference {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  defaultModel String @default("deepseek-v3")
  language     String @default("zh-CN")
  theme        String @default("system")

  // 存储常用 Prompt、工作流偏好等
  customInstructions String? @db.Text
  config             Json?

  @@map("user_preferences")
}

// API Key 管理（用于 CLI / 第三方应用认证）
model ApiKey {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  key         String    @unique // ocean_sk_ 前缀的 API Key
  name        String // Key 名称/备注，如 "CLI Daemon", "VSCode Extension"
  permissions String[]  @default(["read", "write", "execute"]) // 权限范围
  lastUsedAt  DateTime? // 最后使用时间
  expiresAt   DateTime? // 过期时间（NULL = 永不过期）
  revoked     Boolean   @default(false) // 是否已撤销

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([key])
  @@index([revoked])
  @@map("api_keys")
}

// 外部系统凭证（如禅道、GitLab Token）
model UserCredential {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  systemType String // 'zentao', 'gitlab', 'jenkins'
  token      String // 加密后的 Token
  username   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, systemType])
  @@map("user_credentials")
}

// 跨端会话（支持 Web/CLI/IM 漫游）
model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  title         String  @default("New Chat") // 会话标题
  channel       String  @default("web") // 'web', 'cli', 'im'
  status        String  @default("active") // 'active' | 'archived'
  activeSkillId String? // 当前会话锁定的技能 ID

  messages         Message[]
  tasks            Task[] // 编排任务列表
  approvalRequests ApprovalRequest[] // 该会话的审批请求

  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([spaceId])
  @@map("sessions")
}

// 编排任务（Orchestration Task）
model Task {
  id        String  @id @default(uuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  subject  String // 任务标题
  status   String  @default("todo") // 'todo' | 'doing' | 'done' | 'failed'
  order    Int     @default(0) // 排序
  parentId String? // 父任务 ID (用于级联)
  metadata Json? // 任务元数据 (如 progress, error, toolCallId)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@map("tasks")
}

// 对话消息（每条消息独立存储，Server as Source of Truth）
model Message {
  id        String  @id @default(uuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  parentId    String? // 父消息 ID，用于支持对话分支（Tree 结构）
  role        String // 'user' | 'assistant' | 'system'
  content     String  @default("") // 消息文本内容
  parts       Json? // AI SDK UIMessage parts（含 tool-invocation 等）
  attachments Json? // 附件列表（url, name, contentType）
  usage       Json? // Token 用量 { inputTokens, outputTokens, totalTokens }

  // Tracing 关联
  traceId String? // 关联的可观测性 Trace ID

  capsuleSnapshots CapsuleSnapshot[]

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([parentId])
  @@index([traceId])
  @@map("messages")
}

// RAG 知识库文档
model Document {
  id         String  @id @default(uuid())
  title      String
  sourceUrl  String? @map("sourceUrl")
  sourceType String  @default("file") @map("sourceType")
  status     String  @default("processing")
  userId     String? @map("userId")

  // 关联项目
  projectId String?           @map("projectId")
  project   KnowledgeProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Phase 5：文档归属 Space（回填规则：project 有则取 project.spaceId，否则 work）
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  chunks DocumentChunk[]

  metadata  Json?
  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  @@map("documents")
}

// 知识库项目（用于分组管理文档）
model KnowledgeProject {
  id          String  @id @default(uuid())
  name        String
  category    String
  description String? @db.Text
  iconUrl     String? @map("iconUrl")
  color       String?

  documents Document[]

  userId   String? @map("userId")
  isPublic Boolean @default(true) @map("isPublic")

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  @@index([spaceId])
  @@map("knowledge_projects")
}

// RAG 文档切片
model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String   @map("documentId")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  content String @db.Text
  index   Int

  embedding Unsupported("vector(1536)")?
  metadata  Json?
  tsv       Unsupported("tsvector")?

  @@index([documentId])
  @@map("document_chunks")
}

// 链路追踪 (Tracing)
model Trace {
  id        String  @id @default(uuid())
  traceId   String  @unique
  name      String // Trace 名称 (e.g., "Chat Request")
  userId    String?
  sessionId String?

  spans Span[]

  duration Int? // 耗时 (ms)
  status   String @default("ok") // 'ok', 'error'
  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@map("traces")
}

model Span {
  id      String @id @default(uuid())
  traceId String
  trace   Trace  @relation(fields: [traceId], references: [traceId], onDelete: Cascade)

  spanId       String
  parentSpanId String?
  name         String // Span 名称 (e.g., "Tool Call: zentao")
  kind         String  @default("internal") // 'client', 'server', 'internal'

  startTime DateTime
  endTime   DateTime?
  duration  Int?

  attributes Json? // 标签与属性
  events     Json? // 日志事件

  @@index([traceId])
  @@map("spans")
}

// Capsule（交互胶囊）快照表
// 将工具返回的 UI 内容持久化为自包含快照，确保历史对话不依赖外部 API 也能准确还原
// 设计原则：快照存储（非引用），离线可查看，跨设备一致
model CapsuleSnapshot {
  id        String  @id @default(uuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  toolCallId String // 对应 tool invocation 的唯一标识
  uiType     String // 'bug_card' / 'pipeline_card' / 'approval_card' / ...
  title      String   @default("") // 快照标题，如 "缺陷 BUG-123"
  content    Json // 完整 UI props 快照（自包含，不依赖外部 API）
  version    Int      @default(1) // 同一 toolCall 的迭代版本号（未来支持 v1→v2 切换）
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([messageId, toolCallId, version]) // 同一消息下同一工具调用的唯一快照
  @@index([messageId])
  @@map("capsule_snapshots")
}

// 审批请求持久化表
// 替代原有的内存 Map 存储，支持多实例部署、重启不丢失、超时自动过期
model ApprovalRequest {
  id        String  @id @default(uuid()) @db.VarChar(64)
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  toolName   String // 需要审批的工具名称
  args       Json // 工具调用参数快照
  status     String    @default("pending") // 'pending' | 'approved' | 'denied'
  result     Json? // 用户提交的表单数据 (MCP 拦截重试用)
  responseBy String?   @db.VarChar(20) // 操作人工号（谁批准的）
  responseAt DateTime? // 批准/拒绝时间
  expiresAt  DateTime // 超时自动过期（默认 30 分钟）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId, status])
  @@index([expiresAt])
  @@map("approval_requests")
}

// 技能注册表（兼容 Claude Code / OpenClaw Hub SKILL.md 标准）
model Skill {
  id            String                       @id @default(uuid())
  slug          String                       @unique // URL 友好标识，如 "fix-bug"
  name          String // 显示名称
  description   String?                      @db.Text
  category      String? // 'pm' | 'cicd' | 'vc' | 'communication' | 'data_science'
  source        String                       @default("internal") // 'openclaw-hub' | 'claude-code' | 'git' | 'local' | 'internal'
  sourceUrl     String? // 原始来源链接
  version       String? // 语义化版本
  author        String?
  userId        String?
  user          User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  license       String?
  compatibility String? // 依赖声明
  manifest      Json? // SKILL.md frontmatter 原始 JSON
  content       String?                      @db.Text // SKILL.md body 内容
  isFeatured    Boolean                      @default(false)
  isPublic      Boolean                      @default(true)
  icon          String? // lucide icon 名称
  tags          String[] // 标签数组
  triggerKws    String[] // 触发关键词，用于感知上下文注入
  embedding     Unsupported("vector(1536)")?
  installations SkillInstallation[]
  versions      SkillVersion[]
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  @@index([category])
  @@index([source])
  @@index([isFeatured])
  @@map("skills")
}

// 技能安装记录（工作空间/用户级别）
model SkillInstallation {
  id      String  @id @default(uuid())
  skillId String
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  userId  String? // 安装用户（可选，为空表示工作空间级）
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  status  String  @default("active") // 'active' | 'disabled' | 'pending'
  config  Json? // 用户自定义配置

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([skillId, userId])
  @@index([userId])
  @@index([spaceId])
  @@map("skill_installations")
}

// 技能版本历史
model SkillVersion {
  id        String   @id @default(uuid())
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  content   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([skillId])
  @@map("skill_versions")
}

// MCP Server 注册表
model MCPServer {
  id             String    @id @default(uuid())
  name           String
  description    String?   @db.Text
  category       String? // 'pm' | 'cicd' | 'vc' | 'communication' | 'data_science'
  transport      String    @default("stdio") // 'stdio' | 'sse' | 'http'
  command        String? // 启动命令（stdio 模式）
  args           Json? // 启动参数（stdio 模式）
  env            Json? // 环境变量（stdio 模式）
  url            String? // 远程 URL（sse/http 模式）
  headers        Json? // 自定义请求头（sse/http 模式）
  approved       Boolean   @default(false) // 是否已审批
  approvalConfig Json? // 审批配置 JSON {mode, allowedTools, disallowedTools, patterns}
  status         String    @default("unknown") // 'online' | 'degraded' | 'offline' | 'unknown'
  lastCheck      DateTime?
  enabled        Boolean   @default(true)

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId])
  @@map("mcp_servers")
}

// MCP 提示词模板
model MCPPrompt {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  @db.Text
  serverId    String? // 关联的 MCP Server ID（NULL 表示内置提示词）
  template    String   @db.Text
  variables   Json? // 变量定义 [{name, description, required}]
  version     String   @default("1.0.0")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("mcp_prompts")
}

// MCP 资源缓存
model MCPResourceCache {
  id        String   @id @default(uuid())
  uri       String   @unique
  serverId  String? // 来源 MCP Server ID
  content   String   @db.Text
  mimeType  String? // MIME 类型
  expiresAt DateTime // 过期时间
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("mcp_resource_cache")
}

// OAuth 授权码存储（支持多实例部署，5 分钟过期）
model AuthCode {
  id        String   @id @default(uuid())
  code      String   @unique // 授权码
  userId    String // 用户 UUID
  workId    String // 工号
  consumed  Boolean  @default(false) // 是否已被消费（一次性使用）
  expiresAt DateTime // 过期时间（5 分钟）
  createdAt DateTime @default(now())

  @@index([code])
  @@index([expiresAt])
  @@map("auth_codes")
}

// 技能触发日志
model SkillTriggerLog {
  id             String   @id @default(uuid())
  sessionId      String?
  messageId      String?
  triggeredIds   String[] // 本次触发的 Skill ID 列表
  injectedTokens Int?
  createdAt      DateTime @default(now())

  @@index([sessionId])
  @@map("skill_trigger_logs")
}

// 系统配置表
model SystemConfig {
  key         String   @id // 唯一键，如 'skill_creator_prompt'
  value       String   @db.Text
  description String?  @db.Text
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}

// ── Phase 6 6c：Code 投影数据模型 ────────────────────────────────

// 代码仓库（归属 Code Space；组织共享，用户经 Space Membership 访问）
model CodeRepository {
  id            String  @id @default(uuid())
  name          String
  url           String?  @map("url")
  path          String?  // 本地/远端路径
  defaultBranch String  @default("main") @map("defaultBranch")
  description   String? @db.Text
  provider      String  @default("git") // git / gitlab / github / zentao
  lastSyncedAt  DateTime? @map("lastSyncedAt")

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  diffs CodeDiff[]
  terminalSessions TerminalSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId])
  @@map("code_repositories")
}

// 代码 Diff（一对 base/head 引用的变更集，随 Review 流转）
model CodeDiff {
  id           String  @id @default(uuid())
  repositoryId String  @map("repositoryId")
  repository   CodeRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  baseRef      String  @default("main") @map("baseRef")
  headRef      String  @map("headRef")
  title        String?
  status       String  @default("open") // open / merged / closed
  filesChanged Int     @default(0) @map("filesChanged")
  additions    Int     @default(0)
  deletions    Int     @default(0)

  reviews CodeReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([repositoryId])
  @@map("code_diffs")
}

// Code Review（挂在 Diff 上：审批流状态 + 结论）
model CodeReview {
  id         String  @id @default(uuid())
  diffId     String  @map("diffId")
  diff       CodeDiff @relation(fields: [diffId], references: [id], onDelete: Cascade)
  status     String  @default("pending") // pending / approved / changes_requested / rejected
  reviewerId String? @map("reviewerId")
  comment    String? @db.Text
  decidedAt  DateTime? @map("decidedAt")

  createdAt DateTime @default(now())

  @@index([diffId])
  @@map("code_reviews")
}

// ── Phase 6 6d：Work 投影数据模型 ────────────────────────────────

// 工作项目（归属 Work Space；组织共享）
model WorkProject {
  id          String  @id @default(uuid())
  name        String
  description String? @db.Text
  status      String  @default("active") // active / paused / archived
  ownerId     String? @map("ownerId")

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  tasks WorkTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId])
  @@map("work_projects")
}

// 工作任务（项目内的流转单元）
model WorkTask {
  id         String  @id @default(uuid())
  projectId  String  @map("projectId")
  project    WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String
  status     String  @default("todo") // todo / in_progress / done / blocked
  assigneeId String? @map("assigneeId")
  dueAt      DateTime? @map("dueAt")

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([spaceId])
  @@map("work_tasks")
}

// ── Phase 6 6c 尾项：Code 终端投影 ───────────────────────────────

// 终端会话（记录型：真实命令执行留给 CLI/Desktop，此处落历史与产物）
model TerminalSession {
  id           String  @id @default(uuid())
  title        String
  cwd          String?
  status       String  @default("open") // open / closed
  repositoryId String? @map("repositoryId")
  repository   CodeRepository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  commands TerminalCommand[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId])
  @@map("terminal_sessions")
}

// 终端命令（会话内的命令历史）
model TerminalCommand {
  id         String  @id @default(uuid())
  sessionId  String  @map("sessionId")
  session    TerminalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  input      String
  output     String? @db.Text
  exitCode   Int?
  durationMs Int?   @map("durationMs")

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([spaceId])
  @@map("terminal_commands")
}
