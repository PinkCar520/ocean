{
  "name": "ocean",
  "version": "1.0.0",
  "description": "Ocean - 银行内网人工智能工作流中枢",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "turbo run dev",
    "gateway": "pnpm --filter gateway start:dev",
    "web": "pnpm --filter web dev",
    "desktop": "pnpm --filter ocean-desktop dev",
    "daemon": "pnpm --filter @ocean/cli start daemon",
    "all": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test",
    "ci:typecheck": "pnpm --filter @ocean/cli typecheck && pnpm --filter gateway typecheck",
    "ci:unit": "pnpm --filter @ocean/cli test && pnpm --filter gateway test --runInBand",
    "ci:e2e": "pnpm --filter gateway test:e2e",
    "ci:faults": "pnpm --filter @ocean/cli test:faults && pnpm --filter gateway test:faults",
    "clean": "turbo run clean"
  },

  "devDependencies": {
    "prettier": "^3.2.0",
    "ts-morph": "^28.0.0",
    "turbo": "2.9.16",
    "typescript": "^5.4.0"
  }
}
