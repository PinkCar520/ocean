{
  "name": "ocean",
  "version": "1.0.0",
  "description": "Ocean - Exploring What's Next",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "turbo run dev",
    "gateway": "pnpm --filter gateway start:dev",
    "web": "pnpm --filter web dev",
    "desktop": "pnpm --filter ocean-desktop dev",
    "daemon": "pnpm --filter @ocean/cli start daemon",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test",
    "ci:typecheck": "pnpm --filter @ocean/cli typecheck && pnpm --filter gateway typecheck",
    "ci:unit": "pnpm --filter @ocean/core test && pnpm --filter @ocean/cli test && pnpm --filter gateway test --runInBand",
    "ci:e2e": "pnpm --filter gateway test:e2e",
    "ci:faults": "pnpm --filter @ocean/cli test:faults && pnpm --filter gateway test:faults",
    "clean": "turbo run clean",
    "audit:source": "node scripts/engineering/source-intelligence.mjs",
    "audit:test": "node --test scripts/engineering/source-intelligence.test.mjs scripts/engineering/ui-primitive-audit.test.mjs",
    "audit:dead": "knip --reporter json --no-exit-code",
    "audit:duplicates": "jscpd apps packages agents scripts --config .jscpd.json",
    "audit:graph": "node scripts/engineering/toolchain.mjs graph",
    "audit:health": "node scripts/engineering/toolchain.mjs health",
    "audit:tools:test": "node --test scripts/engineering/toolchain.test.mjs scripts/engineering/architecture-gate.test.mjs",
    "audit:architecture": "node scripts/engineering/architecture-gate.mjs reports/engineering/graph scripts/engineering/architecture-baseline.json",
    "audit:codemod": "node scripts/engineering/codemod.mjs",
    "audit:governance": "node scripts/engineering/governance.mjs",
    "audit:verify": "node scripts/engineering/verification.mjs",
    "audit:ui": "node scripts/engineering/ui-primitive-audit.mjs"
  },
  "devDependencies": {
    "dependency-cruiser": "18.9.0",
    "jscpd": "5.4.3",
    "knip": "6.48.0",
    "prettier": "^3.2.0",
    "ts-morph": "^28.0.0",
    "turbo": "2.9.16",
    "typescript": "^5.4.0"
  }
}
