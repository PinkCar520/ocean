{
  "minLines": 5,
  "minTokens": 50,
  "mode": "mild",
  "reporters": [
    "console",
    "json"
  ],
  "output": "reports/engineering/duplicates",
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/out/**",
    "**/.next/**",
    "**/coverage/**"
  ],
  "format": [
    "typescript",
    "tsx",
    "javascript",
    "jsx"
  ]
}
